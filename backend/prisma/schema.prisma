generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  emailVerified Boolean  @default(false)
  avatarUrl     String?
  about         String?  @default("Hey there! I am using Talkora.")
  themeMode     String   @default("system")
  isOnline      Boolean  @default(false)
  lastSeen      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pollVotes     PollVote[]

  // Access control
  role            String    @default("USER")    // USER, ADMIN
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED, BANNED
  statusReason    String?                       // shown to the user on the login screen
  suspendedUntil  DateTime?                     // SUSPENDED users get access back after this
  statusChangedAt DateTime?
  tokenVersion    Int       @default(0)         // bump to log the user out everywhere

  adminActions   AuditLog[] @relation("AuditActor")
  auditEntries   AuditLog[] @relation("AuditTarget")

  // Talkora Plus: active while plusUntil is in the future
  plusUntil          DateTime?
  plusReminderSentAt DateTime? // "your Plus ends soon" email, once per period

  paymentOrders PaymentOrder[]
  aiUsage       AiUsage[]

  otps                OtpVerification[]
  conversationMembers ConversationMember[]

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  reactions     Reaction[]
  notifications Notification[]

  createdGroups Conversation[] @relation("CreatedGroups")

  callsMade     Call[] @relation("CallsMade")
  callsReceived Call[] @relation("CallsReceived")

  messageViews  MessageView[]   // NEW
}

// Every admin action (approve, suspend, role change...). Never shows message content.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  targetId  Int?
  action    String   // e.g. USER_APPROVED, USER_SUSPENDED, ROLE_CHANGED, FORCE_LOGOUT
  details   Json?
  createdAt DateTime @default(now())

  actor  User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetId, createdAt])
}

// One row per payment attempt. Status: PENDING -> PAID / FAILED / EXPIRED
model PaymentOrder {
  id          String    @id                  // our order reference, e.g. TK20261018ABC123
  userId      Int
  plan        String                         // PLUS
  days        Int                            // Plus days this order adds
  amount      Int                            // in rupees (PKR)
  currency    String    @default("PKR")
  provider    String                         // JAZZCASH, TEST, ADMIN
  status      String    @default("PENDING") // PENDING, REVIEW (transfer sent, admin checking), PAID, FAILED, EXPIRED
  providerRef String?                        // the payment company's transaction id
  failReason  String?
  paidAt      DateTime?
  raw         Json?                          // last answer from the payment company (no card data)

  // Manual transfers (bank / Easypaisa / JazzCash wallet / Raast), checked by an admin
  manualMethod String?                       // BANK, EASYPAISA, JAZZCASH_WALLET, RAAST
  manualTid    String?   @unique             // the transfer's transaction ID; can't be reused
  manualSender String?                       // sender name or number the user typed
  proofFile    String?                       // screenshot file name (private folder, admins only)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Talkora AI questions per user per day (free users have a daily limit)
model AiUsage {
  userId Int
  day    DateTime @db.Date
  count  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model Call {
  id              String    @id @default(uuid())
  callerId        Int
  calleeId        Int
  callType        String    @default("audio")   // audio | video
  status          String    @default("calling") // calling, ringing, ongoing, completed, missed, declined, busy, cancelled, failed
  createdAt       DateTime  @default(now())
  ringingAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int       @default(0)

  caller User @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  email     String
  otpHash   String
  purpose   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User? @relation(fields: [userId], references: [id])
  userId Int?
}

model Conversation {
  description String?
  id Int @id @default(autoincrement())

  // DIRECT or GROUP
  type String @default("DIRECT")

  // Used only for GROUP conversations
  name      String?
  avatarUrl String?
  createdBy Int?

  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?

  creator User? @relation("CreatedGroups", fields: [createdBy], references: [id], onDelete: SetNull)

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  joinedAt DateTime @default(now())
  conversationId Int
  userId         Int

  // MEMBER or ADMIN
  role String @default("MEMBER")

  // Used when user clears/deletes a chat
  clearedAt DateTime?

  // Used to count unread group messages for this member
  lastReadAt DateTime @default(now())

  // Used when user deletes/hides a conversation
  hidden Boolean @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  receiverId     Int?      // null for group messages
  body           String?
  messageType    String    @default("TEXT") // TEXT, IMAGE, VIDEO, DOCUMENT, AUDIO, POLL
  fileUrl        String?                    // set to null after the media is destroyed
  fileName       String?
  fileSize       Int?
  mimeType       String?
  duration       Int?      // voice note length in seconds
  createdAt      DateTime  @default(now())

  // NEW: view-once fields
  viewOnce       Boolean   @default(false)  // sender turned on the "1" toggle
  mediaExpired   Boolean   @default(false)  // true once the file has been deleted

  deletedForEveryone Boolean   @default(false)
  deletedAt          DateTime?
  deletedFor         Int[]     @default([])

  readAt   DateTime?
  editedAt DateTime?

  replyToId Int?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  reactions    Reaction[]
  poll         Poll?
  views        MessageView[]  // NEW
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])
  receiver     User?        @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([conversationId, createdAt])
  @@index([replyToId])
  @@index([receiverId])
}

// NEW: tracks who has opened a view-once message
// (a separate table so it also works for groups, where each member can open it once)
model MessageView {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  viewedAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])  // a user can only ever view once
  @@index([messageId])
}

model Reaction {
  id        Int      @id @default(autoincrement())
  emoji     String
  messageId Int
  userId    Int
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Poll {
  id            Int     @id @default(autoincrement())
  messageId     Int     @unique
  question      String
  allowMultiple Boolean @default(false)
  closed        Boolean @default(false)

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     Int    @id @default(autoincrement())
  pollId Int
  text   String
  sort   Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id        Int      @id @default(autoincrement())
  pollId    Int
  optionId  Int
  userId    Int
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId])
}